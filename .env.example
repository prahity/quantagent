# Meterless Nightshift Runtime. Copy to .env and fill the token from the Nightshift Console.
# The NVIDIA API key does not go here. Enter it in Nightshift → Providers → NVIDIA.
# Setup and how to resume a trial: context/session-handoff.md
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# Analysis store. sqlite reads the simulator snapshot. zetaris posts to ZETARIS_QUERY_URL.
# Swap steps: meterless/README.md
ANALYSIS_BACKEND=sqlite
# ZETARIS_QUERY_URL=
# ZETARIS_TOKEN=
# ZETARIS_BARS_VIEW=released_bars
# ZETARIS_FILINGS_VIEW=released_filings
# ZETARIS_DATA_VERSION=
