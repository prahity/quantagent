{"month": "2024-01-02+30d", "query_id": "decision_00018-q13", "goal": "Determine current positions and latest prices to decide orders for this step, respecting max_position_pct_equity and cash constraints.", "sql": "WITH latest_bars AS (\n  SELECT symbol, close AS latest_close FROM bars WHERE interval = 'daily' AND ts = (\n    SELECT MAX(ts) FROM bars WHERE interval = 'daily' AND symbol IN ('AAPL','MSFT','SPY')\n  )\n),\nfilings_info AS (\n  SELECT symbol, title, published_at FROM filings WHERE symbol IN ('AAPL','MSFT','SPY')\n)\nSELECT lb.symbol, lb.latest_close, fi.title, fi.published_at\nFROM latest_bars lb\nLEFT JOIN filings_info fi ON lb.symbol = fi.symbol\nORDER BY lb.symbol", "as_of": "2024-01-29T14:30:00Z", "backend": "sqlite", "data_version": "snap-d5b9a15c35433e85", "columns": ["symbol", "latest_close", "title", "published_at"], "rows": [{"symbol": "AAPL", "latest_close": 192.42, "title": null, "published_at": null}, {"symbol": "AMZN", "latest_close": 159.12, "title": null, "published_at": null}, {"symbol": "GOOGL", "latest_close": 152.19, "title": null, "published_at": null}, {"symbol": "META", "latest_close": 394.14, "title": null, "published_at": null}, {"symbol": "MSFT", "latest_close": 403.93, "title": "8-K: Item 1.05; Regulation FD Disclosure", "published_at": "2024-01-19T21:39:35Z"}, {"symbol": "NVDA", "latest_close": 61.031, "title": null, "published_at": null}, {"symbol": "SPY", "latest_close": 487.41, "title": null, "published_at": null}, {"symbol": "TSLA", "latest_close": 183.25, "title": null, "published_at": null}], "truncated": false, "error": "", "elapsed_ms": 50.8}
